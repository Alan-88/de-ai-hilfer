MCP_PUBLIC_URL=https://de.alan-studio.uk
MCP_PORT=3000

# Enter these values in Gemini Spark's advanced MCP connection settings.
MCP_OAUTH_CLIENT_ID=replace_with_random_client_id
MCP_OAUTH_CLIENT_SECRET=replace_with_random_client_secret

# Preferred: paste the exact URI from Spark's "Copy redirect URI" action.
# Separate multiple exact callback URLs with commas.
MCP_OAUTH_REDIRECT_URIS=https://oauth-redirect.googleusercontent.com/r/replace_with_spark_callback

# Optional bootstrap fallback when an exact callback is unavailable. Trusted
# hosts are accepted only over HTTPS and only below /r/.
MCP_OAUTH_REDIRECT_HOSTS=

# Password shown by the gateway authorization page during account linking.
MCP_OWNER_PASSWORD=replace_with_owner_password

# At least 32 random bytes, for example: openssl rand -hex 32
MCP_TOKEN_SIGNING_SECRET=replace_with_random_signing_secret

# Existing protected Agent API. Docker deployment should use the internal URL.
DEAI_API_URL=http://backend:8000/api/v1
DEAI_API_TOKEN=replace_with_existing_agent_api_token
